# Managed by deploy/school/install.sh. Contains secrets: keep mode 0640 root:labelstudio.
# Values must stay unquoted and free of spaces: the file is read by systemd and by bash.
DJANGO_SETTINGS_MODULE=core.settings.school
SECRET_KEY=${LS_SECRET_KEY}
LABEL_STUDIO_HOST=https://${SERVER_NAME}
ALLOWED_HOSTS=${SERVER_NAME}
CSRF_TRUSTED_ORIGINS=https://${SERVER_NAME}
LABEL_STUDIO_BASE_DATA_DIR=/var/lib/label-studio
HOME=/var/lib/label-studio
JSON_LOG=1
LOG_LEVEL=WARNING
UWSGI_PROCESSES=${UWSGI_PROCESSES}

# PostgreSQL on this host, Unix socket + peer authentication (OS user labelstudio = DB role labelstudio)
DJANGO_DB=postgresql
POSTGRE_HOST=/var/run/postgresql
POSTGRE_PORT=${PG_PORT}
POSTGRE_NAME=labelstudio
POSTGRE_USER=labelstudio

# Garage on this host, loopback only
STORAGE_TYPE=s3
STORAGE_AWS_ENDPOINT_URL=http://127.0.0.1:3900
STORAGE_AWS_REGION_NAME=garage
STORAGE_AWS_BUCKET_NAME=${S3_BUCKET}
STORAGE_AWS_ACCESS_KEY_ID=${S3_KEY_ID}
STORAGE_AWS_SECRET_ACCESS_KEY=${S3_KEY_SECRET}
STORAGE_AWS_S3_SIGNATURE_VERSION=s3v4
STORAGE_AWS_ADDRESSING_STYLE=path
STORAGE_AWS_X_AMZ_EXPIRES=900
